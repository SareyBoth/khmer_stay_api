APP_ENV=development
PORT=8080
DATABASE_URL=postgres://khmerstay:khmerstay@localhost:5432/khmerstay?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_LIFETIME_MINUTES=720
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MIGRATIONS_DIR=migrations
UPLOADS_DIR=uploads
SEED_DEMO=true

# SMTP for password-reset codes. Development logs codes when SMTP_HOST is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@khmerstay.local

# Resend is preferred over SMTP when RESEND_API_KEY is set.
# Verify the sending domain in Resend before using a production address.
RESEND_API_KEY=
RESEND_FROM=KhmerStay <no-reply@your-domain.com>
RESEND_API_BASE_URL=https://api.resend.com

# Google OAuth web/server client ID. The mobile app requests an ID token for
# this audience and the API verifies it before creating or signing in a user.
GOOGLE_CLIENT_ID=

# Bakong Open API / dynamic KHQR. Never commit real values.
BAKONG_ACCOUNT_ID=
BAKONG_API_TOKEN=
BAKONG_API_BASE_URL=https://api-bakong.nbc.gov.kh
BAKONG_MERCHANT_NAME=KhmerStay
BAKONG_MERCHANT_CITY=PHNOM PENH
BAKONG_CURRENCY=USD
BAKONG_QR_TTL_SECONDS=600
BAKONG_WEBHOOK_SECRET=

# Currency & Rates (National Bank of Cambodia indicative rate)
NBC_EXCHANGE_RATE=4100

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Media Upload Storage (local or s3)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-southeast-1
S3_PUBLIC_URL=
